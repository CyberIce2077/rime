{
  "name": "rime-cli",
  "version": "0.0.1",
  "description": "A minimal, token-frugal AI coding CLI for the terminal",
  "keywords": [
    "cli",
    "ai",
    "coding",
    "llm",
    "llama.cpp",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberIce2077/rime.git"
  },
  "homepage": "https://github.com/CyberIce2077/rime#readme",
  "bugs": "https://github.com/CyberIce2077/rime/issues",
  "type": "module",
  "bin": {
    "rime": "dist/rime.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --experimental-strip-types --no-warnings src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
